# Directory patterns are anchored with a leading slash so they match only the
# repo root. Unanchored "docs/" also matched .maister/docs/, which silently
# excluded the project standards.
/ref/
/docs/
/docs_1044/
/captures/
/_to_delete/
/.venv/
__pycache__/

# Research task artifacts: 72 findings files, the decoder and a 5.3 MB catalog.
# .maister/docs/ (project standards) IS tracked; only task output is excluded.
/.maister/tasks/

# The full 42-key catalog is the mining input, not shipped data: 3.4 MB, regenerated by
#   .venv/Scripts/python.exe -m eagan_mcp.preset_file eagan_mcp/knowledge
# from HAKEN_EDITOR_DIR. The trimmed corrected view ships as factory_catalog.json beside
# it, together with preset_index_1081.json, census.json and descriptions.json.
/eagan_mcp/knowledge/factory_catalog_full.json
